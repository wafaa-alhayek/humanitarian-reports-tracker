# Which model reads the reports: gemini | ollama | rules (no AI, offline baseline)
LLM_BACKEND=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Where results are stored: duckdb (local file) | bigquery
STORE=duckdb
DUCKDB_PATH=data/reports.duckdb
BQ_PROJECT=
BQ_DATASET=humanitarian_reports
BQ_LOCATION=EU

# Optional: an approved ReliefWeb API appname (otherwise the public RSS feed is used)
RELIEFWEB_APPNAME=
